{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opl.onepersonlab/contracts/opl-bookforge/shape-storyline.input.schema.json",
  "title": "OPL Book Forge storyline input",
  "type": "object",
  "required": [
    "workspace_root",
    "book_id"
  ],
  "properties": {
    "book_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Exact project_id of the book in the authorized workspace_index.json."
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
